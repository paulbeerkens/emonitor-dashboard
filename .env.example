# The collector and dashboard repositories are expected to be siblings in ~/src.
EMONITOR_DATABASE_PATH=../emonitor/db/emonitor.db
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
# Delivery and other usage-based charges (adjustments, programs, and taxes) derived from the
# October 13, 2026 bill. Fixed charges are intentionally excluded.
COMED_VARIABLE_ADDON_CENTS_PER_KWH=7.791438
# Chicago-area coordinates used for the solar chart's sunrise/sunset markers.
SOLAR_LATITUDE=41.8781
SOLAR_LONGITUDE=-87.6298

